# Copy to .env. Defaults run everything on the local Firebase emulators (no credentials needed).

# API server (apps/server). On a real phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# 1 = talk to the Firebase emulators, 0 = talk to a real Firebase project
EXPO_PUBLIC_USE_EMULATORS=1
# Host the phone uses to reach the emulators (your computer's LAN IP on a real phone; 10.0.2.2 on the Android emulator)
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Firebase Web app config (see docs/firebase-setup.md). With emulators, only PROJECT_ID matters.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gatehood.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-gatehood
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
