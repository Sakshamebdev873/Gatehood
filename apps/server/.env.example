# Copy to .env (gitignored). Every value below has a working default for the emulators.

# API port. The app reaches it on your LAN IP, so the server listens on 0.0.0.0.
PORT=4000

# Firebase project. demo-gatehood is the emulator project and needs no credentials.
FIREBASE_PROJECT_ID=demo-gatehood

# Emulators: set BOTH to use them, or NEITHER to use a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Real project only: path to a service-account key. Never commit this file.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Invite codes expire this many days after import.
INVITE_TTL_DAYS=30

# Builder login created by `npm run seed`.
BUILDER_EMAIL=builder@gatehood.demo
BUILDER_PASSWORD=gatehood-demo
