{
  "name": "@gatehood/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,auth --project demo-gatehood --config ../../firebase/firebase.json \"vitest run\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gatehood --config ../../firebase/firebase.json \"vitest run rules\"",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "firebase": "^13.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
